# JPL
# Janurary 29, 2026

CONFIGFILES=" \
./global.ionrc \
./2.ipn.udp/ipn.bprc \
./2.ipn.udp/ipn.ionconfig \
./2.ipn.udp/ipn.ionrc \
./2.ipn.udp/ipn.ionsecrc \
./2.ipn.udp/ipn.ipnrc \
./2.ipn.udp/ipn.bpsecrc \
./3.ipn.udp/ipn.bprc \
./3.ipn.udp/ipn.ionconfig \
./3.ipn.udp/ipn.ionrc \
./3.ipn.udp/ipn.ionsecrc \
./3.ipn.udp/ipn.ipnrc \
./3.ipn.udp/ipn.bpsecrc \
"

# Randomize Port numbers so runners do not overlap
readarray -t port_nums < <(shuf -i 2000-3000 -n 3)
# Proxy port modification ipnrc
sed -i "s/5115/${port_nums[0]}/g" 2.ipn.udp/ipn.ipnrc
sed -i "s/5115/${port_nums[0]}/g" 3.ipn.udp/ipn.ipnrc
# Proxy Port modification bprc
sed -i "s/5115/${port_nums[0]}/g" 2.ipn.udp/ipn.bprc
sed -i "s/5115/${port_nums[0]}/g" 3.ipn.udp/ipn.bprc
# Induct Port modification
sed -i "s/2112/${port_nums[2]}/g" 2.ipn.udp/ipn.bprc
sed -i "s/3113/${port_nums[1]}/g" 3.ipn.udp/ipn.bprc

echo "########################################"
echo
pwd | sed "s/\/.*\///" | xargs echo "NAME: "
echo
echo "PURPOSE: Demonstrate BIB protecting against a MITM attack."
echo
echo "CONFIG: 2 node custom configuration:"
echo
for N in $CONFIGFILES
do
    echo "$N:"
    cat $N
    echo "# EOF"
    echo
done
echo "OUTPUT: Terminal messages will relay results."
echo
echo "########################################"

# Check if python3 is available
if ! command -v python3 &> /dev/null; then
    echo "SKIP: python3 is required but not found. Please install Python 3."
    exit 2
fi

PYTHON_VERSION=$(python3 -c 'import sys; print(".".join(map(str, sys.version_info[:2])))')
PYTHON_MAJOR=$(python3 -c 'import sys; print(sys.version_info[0])')
PYTHON_MINOR=$(python3 -c 'import sys; print(sys.version_info[1])')
if [ "$PYTHON_MAJOR" -lt 3 ] || { [ "$PYTHON_MAJOR" -eq 3 ] && [ "$PYTHON_MINOR" -lt 10 ]; }; then
    echo "SKIP: Python 3.10 or higher is required. Found version $PYTHON_VERSION"
    exit 2
fi
echo "Using Python $PYTHON_VERSION"
echo

./cleanup
RETVAL=1

echo
echo "Starting MITM server..."
echo
python3 mitm_test.py --proxy-port ${port_nums[0]} --src-node 3 --dst-node 2 --src-port ${port_nums[1]} --dst-port ${port_nums[2]} --modify &
MITMPID=$!

echo "Starting ION..."
echo
export ION_NODE_LIST_DIR=$PWD
cd 2.ipn.udp
./ionstart > node.stdout

cd ../3.ipn.udp
./ionstart > node.stdout

echo
echo "Starting bpecho on ipn:3.1 ..."
sleep 1
bpecho ipn:3.1 >/dev/null &
ECHOPID=$!

cd ../2.ipn.udp
echo "Sending bping..."
echo
bping -c 3 ipn:2.1 ipn:3.1
TEST_RESULT=$?

if [ $TEST_RESULT -eq 1 ]; then
    echo
    echo "SUCCESS: All status report scenarios passed."
    RETVAL=0
else
    echo
    echo "ERROR: One or more status report scenarios failed."
    RETVAL=1
fi

echo
echo "Stopping ION..."
kill $ECHOPID
ionexit
sleep 1
cd ../
# will produce errors as previous ionexit will kill somethings
cd ../3.ipn.udp
echo "Status reports test completed."
exit $RETVAL
