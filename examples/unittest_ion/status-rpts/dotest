CONFIGFILES=" \
./global.ionrc \
./3.ipn.udp/amroc.bprc \
./3.ipn.udp/amroc.ionconfig \
./3.ipn.udp/amroc.ionrc \
./3.ipn.udp/amroc.ionsecrc \
./3.ipn.udp/amroc.ipnrc \
"

echo "########################################"
echo
pwd | sed "s/\/.*\///" | xargs echo "NAME: "
echo
echo "PURPOSE: To determine if bundle status reports are generated."
echo
echo "CONFIG: 3 node custom configuration (only node 3 is an ION node):"
echo
for N in $CONFIGFILES
do
    echo "$N:"
    cat $N
    echo "# EOF"
    echo
done
echo "OUTPUT: Terminal messages will relay results."
echo
echo "########################################"

# Check if python3 is available
if ! command -v python3 &> /dev/null; then
    echo "SKIP: python3 is required but not found. Please install Python 3."
    exit 2
fi

PYTHON_VERSION=$(python3 -c 'import sys; print(".".join(map(str, sys.version_info[:2])))')
PYTHON_MAJOR=$(python3 -c 'import sys; print(sys.version_info[0])')
PYTHON_MINOR=$(python3 -c 'import sys; print(sys.version_info[1])')
if [ "$PYTHON_MAJOR" -lt 3 ] || { [ "$PYTHON_MAJOR" -eq 3 ] && [ "$PYTHON_MINOR" -lt 10 ]; }; then
    echo "SKIP: Python 3.10 or higher is required. Found version $PYTHON_VERSION"
    exit 2
fi
echo "Using Python $PYTHON_VERSION"
echo

./cleanup
RETVAL=1

echo "Starting ION..."
export ION_NODE_LIST_DIR=$PWD
cd 3.ipn.udp
./ionstart > node.stdout

echo "Starting bpsink on ipn:3.1 ..."
sleep 1
bpsink ipn:3.1 >/dev/null &

cd ../
echo "Running bespokebpv7 status report test..."
# First Bundle: Sent to ipn:3.1 (should be delivered)
# Second Bundle: Sent to ipn:5.1 (should be forwarded)
# Third Bundle: Sent to ipn:3.3 (should be deleted)
python3 runtest.py -p parms.json
TEST_RESULT=$?

if [ $TEST_RESULT -eq 0 ]; then
    echo "SUCCESS: All status report scenarios passed."
    RETVAL=0
else
    echo "ERROR: One or more status report scenarios failed."
    RETVAL=1
fi

echo
echo "Stopping ION..."
killm
echo "Status reports test completed."
exit $RETVAL
